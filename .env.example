# Copia este archivo a .env y completa con tus datos reales.
# En GitHub Actions, estos mismos nombres van como "Secrets" del repo (Settings > Secrets and variables > Actions).

# Supabase (Settings > API en tu proyecto de supabase.com)
SUPABASE_URL=https://TUPROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Identificación honesta del bot ante los sitios (no simular ser un navegador de usuario real)
SCRAPER_USER_AGENT=AhorraLimaBot/0.1 (+https://tu-dominio.pe/bot; contacto@tu-dominio.pe)

# Milisegundos de espera entre cada request, por cadena, para no saturar sus servidores
REQUEST_DELAY_MS=1200
